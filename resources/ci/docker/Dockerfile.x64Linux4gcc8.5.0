FROM rockylinux/rockylinux:8.10.20240528

ARG USER_NAME=jenkins
ARG USER_UID

ENV CONNEXTDDS_ARCH="x64Linux4gcc8.5.0"

RUN dnf update -y && dnf install -y \
        gcc \
        gcc-c++ \
        clang \
        clang-analyzer \
        clang-tools-extra \
        make \
        cmake \
        libcurl-devel \
        openssl-devel \
        libxml2-devel \
        python38 \
        python38-devel \
        python38-pip \
        python38-setuptools \
        shadow-utils \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN ln -s /usr/bin/python3.8 /usr/local/bin/python3 \
    && ln -s /usr/bin/pip3.8 /usr/local/bin/pip3

RUN useradd -u ${USER_UID} -m ${USER_NAME}
ENV PATH=/home/$USER_NAME/.local/bin:$PATH

USER $USER_NAME
